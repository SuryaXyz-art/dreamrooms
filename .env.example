# DreamRooms environment contract. Keep this file secret-free.
# Phase 2 connects the SDK for read-only market data; Phase 4 adds server-owned
# room/social persistence. Live Shannon defaults are
# supplied by the pinned SDK when these public overrides are blank.

# Optional explicit local fixture mode. Leave blank to use live Shannon reads;
# set to `demo` only when intentionally testing the labelled fixture UI.
DREAMROOMS_DATA_MODE=

# Public Somnia Shannon chain configuration. The SDK chain definition is the
# preferred source; set these only when an endpoint override is needed.
# Browser wallet writes use the injected wallet on the same Shannon chain; no
# wallet private-key variable belongs in this file.

# Never add wallet private keys here. Browser wallets sign all transactions.
NEXT_PUBLIC_SOMNIA_CHAIN_ID=
NEXT_PUBLIC_SOMNIA_RPC_URL=
NEXT_PUBLIC_SOMNIA_WS_RPC_URL=

# Public DreamDEX indexer endpoint for discovery/history. Do not place an
# indexer admin secret in a NEXT_PUBLIC variable.
NEXT_PUBLIC_DREAMDEX_INDEXER_URL=

# Optional runtime venue scope. Leave empty until a live row's venueId and
# operatorId have been discovered and verified for the selected deployment.
NEXT_PUBLIC_DREAMDEX_VENUE_ID=
NEXT_PUBLIC_DREAMDEX_OPERATOR_ID=

# Read-only smoke test switch. Set only in the shell running the test; it is
# not needed by the app and should not be enabled for normal test runs.
RUN_DREAMDEX_SMOKE=

# Supabase public project configuration. Enforce row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret for narrowly scoped Route Handler writes.
# Never expose this value to browser code or commit it.
SUPABASE_SECRET_KEY=

# Short-lived wallet session signing secret. Generate locally with a secure random generator;
# never commit or print it. Browser wallets sign messages, not this secret.
DREAMROOMS_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
